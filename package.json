{
  "name": "solar-moon-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.6",
    "@hookform/resolvers": "^5.9.1",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^9.17.0",
    "@szhsin/react-menu": "^4.5.2",
    "@tippyjs/react": "^4.2.6",
    "@wojtekmaj/react-daterange-picker": "^7.0.0",
    "aws-amplify": "^6.22.0",
    "axios": "^1.18.0",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-csv": "^2.2.2",
    "react-data-grid": "^7.0.0-beta.59",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-icons": "^5.7.0",
    "react-intl": "^12.1.3",
    "react-router": "^8.4.0",
    "react-select": "^5.10.2",
    "react-timezone-select": "^3.3.3",
    "react-toastify": "^11.1.0",
    "sass": "^1.105.0",
    "usehooks-ts": "^3.1.1",
    "uuid": "^14.0.2",
    "yup": "^1.7.1"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx && stylelint \"**/*.{css,scss}\"",
    "lint-fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix && stylelint \"**/*.{css,scss}\" --fix"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chart.js": "^4.0.1",
    "@types/classnames": "^2.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@types/testing-library__react": "^10.0.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "babel-plugin-transform-vite-meta-env": "^1.0.3",
    "baseline-browser-mapping": "^2.11.26",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-prettier": "^5.0.3",
    "tailwindcss": "^4.3.3",
    "type-coverage": "^2.29.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts",
      "!src/graphql/**/*",
      "!src/aws-exports.js",
      "!src/index.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "src/graphql/",
      "src/aws-exports.js",
      "src/index.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(uuid|usehooks-ts))"
    ]
  },
  "proxy": "https://app.solarmoonanalytics.com"
}
